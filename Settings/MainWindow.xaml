<Window
    x:Class="ShakeCursor.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/ShakeCursor.ico" Width="16" Height="16" />
                <TextBlock Text="ShakeCursor" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="232"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Size" Tag="Size">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE740;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shake" Tag="Shake">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Apps" Tag="Apps">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="36,8,36,24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Live preview: a round stage the arrow grows from its centre inside -->
                <Grid Height="190" HorizontalAlignment="Center">
                    <Grid Width="176" Height="176" VerticalAlignment="Center">
                        <Ellipse
                            StrokeThickness="1"
                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Canvas x:Name="PreviewCanvas" Width="176" Height="176">
                            <Canvas x:Name="ArrowHost">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="ArrowScale" ScaleX="1" ScaleY="1" CenterX="8.75" CenterY="15" />
                                </Canvas.RenderTransform>
                                <shapes:Polygon x:Name="ArrowShadow" Fill="#46000000" />
                                <shapes:Polygon x:Name="ArrowOutline" Stroke="White" StrokeThickness="4" StrokeLineJoin="Round" />
                                <shapes:Polygon x:Name="ArrowFill" Fill="Black" />
                            </Canvas>
                        </Canvas>
                        <TextBlock x:Name="ScaleReadout"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <Grid>
                        <!-- Size -->
                        <StackPanel x:Name="PageSize" Spacing="4">
                            <TextBlock Text="Size" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,8" />
                            <controls:SettingsCard Header="At rest">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Slider x:Name="RestSlider" Width="260" Minimum="0.5" Maximum="2" StepFrequency="0.05" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RestValue" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="When shaking">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Slider x:Name="MaxSlider" Width="260" Minimum="1.5" Maximum="4" StepFrequency="0.1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MaxValue" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>

                        <!-- Shake -->
                        <StackPanel x:Name="PageShake" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Shake" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,8" />
                            <controls:SettingsCard Header="Sensitivity">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Slider x:Name="SensSlider" Width="260" Minimum="0.5" Maximum="2" StepFrequency="0.1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SensValue" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Hold time">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Slider x:Name="LingerSlider" Width="260" Minimum="0.25" Maximum="3" StepFrequency="0.25" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LingerValue" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel x:Name="PageAppearance" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,8" />
                            <controls:SettingsCard Header="Fill">
                                <Button x:Name="FillButton" MinWidth="130">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border x:Name="FillSwatch" Width="20" Height="20" CornerRadius="10"
                                                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="FillHex" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="FillPicker" IsAlphaEnabled="False"
                                                         IsHexInputVisible="True" IsColorChannelTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Outline">
                                <Button x:Name="OutlineButton" MinWidth="130">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border x:Name="OutlineSwatch" Width="20" Height="20" CornerRadius="10"
                                                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="OutlineHex" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="OutlinePicker" IsAlphaEnabled="False"
                                                         IsHexInputVisible="True" IsColorChannelTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Swap fill and outline">
                                <Button x:Name="SwapButton" Content="Swap" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Shadow">
                                <ToggleSwitch x:Name="ShadowToggle" OnContent="" OffContent="" MinWidth="0" />
                            </controls:SettingsCard>
                        </StackPanel>

                        <!-- Apps -->
                        <StackPanel x:Name="PageApps" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Apps" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,8" />
                            <controls:SettingsCard Header="Excluded apps">
                                <Button x:Name="AddAppButton" Content="Add">
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="AddAppMenu" Opening="AddAppMenu_Opening" />
                                    </Button.Flyout>
                                </Button>
                            </controls:SettingsCard>
                            <Grid>
                                <ListView x:Name="AppList" SelectionMode="None" Margin="0,4,0,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Tag="{x:Bind}" Click="RemoveApp_Click"
                                                        Background="Transparent" BorderThickness="0" Padding="8">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="AppsEmpty" Text="None" Margin="4,12,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- General -->
                        <StackPanel x:Name="PageGeneral" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,8" />
                            <controls:SettingsCard Header="Start with Windows">
                                <ToggleSwitch x:Name="AutostartToggle" OnContent="" OffContent="" MinWidth="0" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Desktop shortcut">
                                <ToggleSwitch x:Name="ShortcutToggle" OnContent="" OffContent="" MinWidth="0" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Download updates automatically"
                                                   Description="Checks for a new version every 12 hours. You can still check by hand below.">
                                <ToggleSwitch x:Name="AutoUpdateToggle" OnContent="" OffContent="" MinWidth="0" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Name="UpdateCard" Header="ShakeCursor">
                                <Button x:Name="UpdateButton" Content="Check for updates" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Button x:Name="ResetButton" Grid.Row="2" Content="Reset to defaults" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
