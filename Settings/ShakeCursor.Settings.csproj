<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ShakeCursor.Settings</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyName>ShakeCursor.Settings</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ShakeCursor.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the tray app so both sides agree on the file format and feel. -->
    <Compile Include="..\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\ShakeDetector.cs" Link="Shared\ShakeDetector.cs" />
    <Compile Include="..\ArrowGeometry.cs" Link="Shared\ArrowGeometry.cs" />
    <Compile Include="..\UpdateBridge.cs" Link="Shared\UpdateBridge.cs" />
    <Compile Include="..\Hotkey.cs" Link="Shared\Hotkey.cs" />
    <Content Include="Assets\ShakeCursor.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A self-contained Windows App SDK publish copies the whole framework payload,
    including ~50 MB this app never touches (Windows AI / ML runtime, widgets)
    and 80+ localized resource folders. Drop them after publishing; the UI is
    English-only and falls back to the built-in en-us resources.
  -->
  <Target Name="TrimUnusedWindowsAppSdk" AfterTargets="Publish" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <ItemGroup>
      <UnusedFile Include="$(PublishDir)Microsoft.Windows.AI*;$(PublishDir)Microsoft.ML.OnnxRuntime.dll;$(PublishDir)onnxruntime*.dll;$(PublishDir)DirectML.dll" />
      <UnusedFile Include="$(PublishDir)Microsoft.Windows.Workloads*;$(PublishDir)Microsoft.Windows.Private.Workloads*;$(PublishDir)workloads*.json" />
      <UnusedFile Include="$(PublishDir)Microsoft.Windows.Widgets*" />
      <PublishSubDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <UnusedDir Include="@(PublishSubDir)"
                 Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^[a-z]{2,3}(-[A-Za-z0-9]+)+$')) And '%(Filename)' != 'en-us'" />
      <UnusedDir Include="$(PublishDir)NpuDetect" />
    </ItemGroup>
    <Delete Files="@(UnusedFile)" />
    <RemoveDir Directories="@(UnusedDir)" />
  </Target>

</Project>
