<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\ShakeCursor.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyName>ShakeCursor</AssemblyName>
    <RootNamespace>ShakeCursor</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ShakeCursor.ico" LogicalName="ShakeCursor.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WinUI 3 settings app lives in Settings\ and builds as its own project. -->
    <Compile Remove="Settings\**" />
    <EmbeddedResource Remove="Settings\**" />
    <None Remove="Settings\**" />
  </ItemGroup>

  <Target Name="BuildSettingsApp" AfterTargets="Build" Condition="'$(SkipSettingsBuild)' != 'true'">
    <PropertyGroup>
      <SettingsOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)Settings'))</SettingsOutDir>
    </PropertyGroup>
    <!-- A nested project is not restored by the outer restore, so restore it first
         (a unique session id forces a fresh evaluation after the restore). -->
    <MSBuild Projects="Settings\ShakeCursor.Settings.csproj" Targets="Restore"
             Properties="Platform=x64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="Settings\ShakeCursor.Settings.csproj"
             Properties="Configuration=$(Configuration);Platform=x64;OutDir=$(SettingsOutDir)" />
  </Target>

</Project>
